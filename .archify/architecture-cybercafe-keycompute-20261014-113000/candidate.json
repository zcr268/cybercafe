  "cards": [
    {
      "dot": "cyan",
      "title": "两套系统独立共存",
      "items": [
        "CyberCafe：只管机器好不好用——部署、调度、缓存命中、预留机保护",
        "KeyCompute：只管生意——对外销售、定价、计费、限额拦截、账本",
        "各自独立部署与升级，互不改库；左右分柱与配色区分归属"
      ]
    },
    {
      "dot": "emerald",
      "title": "唯一接口在机房内",
      "items": [
        "外部客户端只进 slave：真实请求 → 本地鉴权与拦截 → 转发 L2 内部网关",
        "L2 入队 → 调度器选适配器 → 下发 L3 管理机执行 → 结果沿原路回传",
        "KeyCompute 内部两条规范流：配置流 主→从（etcd）、事件流 从→主（Kafka）"
      ]
    },
    {
      "dot": "rose",
      "title": "硬边界",
      "items": [
        "master 不承载推理流量，slave 是唯一对外推理面",
        "L3 无公网暴露，外部拿不到机房内地址",
        "CyberCafe 不碰定价与钱；KeyCompute 不下场管机器"
      ]
    }
  ]
}