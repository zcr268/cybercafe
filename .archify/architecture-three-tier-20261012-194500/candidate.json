  "cards": [
    {
      "dot": "cyan",
      "title": "任务生命周期",
      "items": [
        "POST /v1/tasks → API Key 鉴权 → 入队 → 调度器查模型池",
        "池 = 已部署该档位的机器，池内负载最少优先，池满排队",
        "下发 L3 执行 → 进度/结果回传 → 客户端轮询取回"
      ]
    },
    {
      "dot": "emerald",
      "title": "缓存两层（全组件通用）",
      "items": [
        "镜像层按规格指纹（GPU+显存+驱动+内存+CPU）免构建",
        "权重层按 (组件,模型,版本) 键免下载，OCR/ComfyUI/H3 全纳入",
        "L3 部署与模型加载命中缓存直接拉取"
      ]
    },
    {
      "dot": "rose",
      "title": "本期边界",
      "items": [
        "无文生文 / 无 SSE 流式；无跨网吧调度；无配额阈值",
        "L2 单点（对等集群后话）；L3 无公网暴露、无降级直连",
        "结果回传先轮询；预留机保护已知流量高峰"
      ]
    }
  ]
